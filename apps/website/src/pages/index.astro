---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout
  title="About"
  description="A personal blog about building for the web."
>
  <section class="mx-auto max-w-3xl">
    <h1 class="mb-1">Hi 👋</h1>
    <p class="m-0 text-lg text-muted">Full-stack developer · building for the modern web</p>

    <p class="mt-10 text-lg leading-relaxed">
      I'm a developer who cares about the details — fast sites, clean APIs, and tooling
      that gets out of the way. This is my corner of the internet, where I write about
      what I'm building, breaking, and learning.
    </p>
  </section>
</MainLayout>
