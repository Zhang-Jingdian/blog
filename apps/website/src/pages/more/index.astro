---
import MainLayout from '../../layouts/MainLayout.astro'

const username = 'Zhang-Jingdian'
const profileUrl = `https://github.com/${username}`
const avatarUrl = `https://github.com/${username}.png`
---

<MainLayout title={`GitHub · ${username}`} description={`GitHub profile of ${username}`}>
  <section class="grid min-h-[60vh] place-items-center py-10">
    <div>
      <div class="scene">
        <a
          id="gh-card"
          class="card"
          href={profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-api={`https://api.github.com/users/${username}`}
          aria-label={`GitHub profile of ${username}`}
        >
          <img
            id="gh-avatar"
            class="avatar"
            src={avatarUrl}
            alt=""
            width="96"
            height="96"
            loading="lazy"
          />
          <div class="body">
            <h2 class="login">@{username}</h2>
            <div class="stats">
              <div class="stat">
                <strong id="gh-repos">—</strong>
                <span>Repos</span>
              </div>
              <div class="stat">
                <strong id="gh-followers">—</strong>
                <span>Followers</span>
              </div>
              <div class="stat">
                <strong id="gh-following">—</strong>
                <span>Following</span>
              </div>
            </div>
            <span class="cta">View profile <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .scene {
    perspective: 1200px;
  }
  .card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(440px, 90vw);
    padding: 2rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(135deg, #0d1117, #161b22 60%, #1f2937);
    color: #e6edf3;
    text-decoration: none;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    transform-style: preserve-3d;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    will-change: transform;
  }
  .card:hover {
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
  }
  .avatar {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    /* border: 2px solid rgba(255, 255, 255, 0.15); */
    /* box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4); */
    transform: translateZ(40px);
  }
  .body {
    transform: translateZ(30px);
  }
  .login {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    color: #fff;
  }
  .stats {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .stat strong {
    font-size: 1.2rem;
    color: #fff;
  }
  .stat span {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8b949e;
  }
  .cta {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
  }
  @media (max-width: 480px) {
    .card {
      flex-direction: column;
      text-align: center;
    }
    .stats {
      justify-content: center;
    }
  }
</style>

<script is:inline>
  (() => {
    const card = document.getElementById('gh-card');
    const set = (id, text) => {
      const el = document.getElementById(id);
      if (el && text != null && text !== '') el.textContent = text;
    };

    // 3D tilt.
    const MAX = 12; // degrees
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      card.style.transform =
        `rotateX(${(0.5 - py) * MAX * 2}deg) rotateY(${(px - 0.5) * MAX * 2}deg)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });

    // Live public stats only (repos / followers / following). The card deliberately
    // omits name, bio, and location to avoid exposing personal details.
    fetch(card.dataset.api)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(r.status))))
      .then((u) => {
        set('gh-repos', u.public_repos);
        set('gh-followers', u.followers);
        set('gh-following', u.following);
      })
      .catch(() => {
        // Keep the static placeholder dashes.
      });
  })();
</script>
